# secrets and local config (each person has their own .env)
.env
*.p8
*.pem
*.key

# generated data (keep the empty folder)
data/*
!data/.gitkeep

# python
__pycache__/
*.pyc
venv/
.venv/

# logs and build output
**/logs/
/.dist

# dbt
dbt/target/
dbt/dbt_packages/

# os / editor (shared VS Code settings are kept)
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
